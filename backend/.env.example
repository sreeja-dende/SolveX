# Copy to backend/.env for local development (never commit .env)
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/solvex?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE=7d
# Required to create an admin account (send it as "adminKey" in the register request)
ADMIN_SETUP_KEY=change-me
# Optional: Gmail + App Password for password-reset OTP emails
EMAIL_USER=
EMAIL_PASS=
